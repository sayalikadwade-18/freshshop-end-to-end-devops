stage('Deploy To Docker Servers') {

    parallel {

        stage('Deploy Docker Server 1') {

            steps {

                sshagent(['ubuntu_docker']) {

                    sh '''

                    ssh -o StrictHostKeyChecking=no ubuntu@67.202.45.65 "
                    mkdir -p ~/website
                    "

                    scp -o StrictHostKeyChecking=no -r \
                    freshshop-master \
                    ubuntu@67.202.45.65:~/website/


                    ssh -o StrictHostKeyChecking=no ubuntu@67.202.45.65 "

                    cd ~/website/freshshop-master

                    docker rm -f freshshop-master || true

                    docker build -t mywebsite1 .

                    docker run -d \
                    -p 8085:80 \
                    --name freshshop-master \
                    mywebsite1

                    docker ps

                    "

                    '''

                }

            }

        }


        stage('Deploy Docker Server 2') {

            steps {

                sshagent(['ubuntu_docker']) {

                    sh '''

                    ssh -o StrictHostKeyChecking=no ubuntu@32.192.23.21 "
                    mkdir -p ~/website
                    "


                    scp -o StrictHostKeyChecking=no -r \
                    freshshop-master \
                    ubuntu@32.192.23.21:~/website/


                    ssh -o StrictHostKeyChecking=no ubuntu@32.192.23.21 "

                    cd ~/website/freshshop-master


                    docker rm -f freshshop-master || true


                    docker build -t mywebsite1 .


                    docker run -d \
                    -p 8085:80 \
                    --name freshshop-master \
                    mywebsite1


                    docker ps

                    "

                    '''

                }

            }

        }

    }

}
